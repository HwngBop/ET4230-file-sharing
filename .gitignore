client_data/downloads/*
client_data/uploads/*
!client_data/downloads/.gitkeep
!client_data/uploads/.gitkeep

# Server shared storage and upload staging (keep the folder via .gitkeep)
src/server/storage/*
!src/server/storage/.gitkeep

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated measurement fixtures / scratch
/test_files/
/work/
